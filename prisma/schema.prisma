generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  password        String
  balance         Float         @default(0)
  investBalance   Float         @default(0)
  tradeBalance    Float         @default(0)
  projectBalance  Float         @default(0)
  hasInvested     Boolean       @default(false)
  role            String        @default("user")
  emailVerified   Boolean       @default(false)
  depositCount    Int           @default(0)
  firstDepositAt  DateTime?
  lastClaimAt     DateTime?
  referralCode    String        @unique
  referredByCode  String?
  referralCount   Int           @default(0)
  totalProfit     Float         @default(0)
  totalLoss       Float         @default(0)
  unlockedLevel   Int           @default(1)
  requiredReferrals Int         @default(0)
  totalInvestClaims Int         @default(0)
  investClaimBlocked Boolean     @default(false)
  worldLinkSeen   Boolean       @default(false)
  phone           String?       @unique
  sessionToken    String?
  referralRewardClaimed Boolean @default(false)
  heldInvestBalance Float      @default(0)
  heldReleaseAt     DateTime?

  // ===== Espace Jeunes — Mission & Micro-Prêt System =====
  // Mission earnings (from validated images, separate from deposits)
  missionBalance       Float     @default(0)
  // Total earned from all validated images ever
  missionTotalEarned   Float     @default(0)
  // Number of validated images today
  missionValidatedToday Int     @default(0)
  // Date string YYYY-MM-DD for daily limit tracking
  missionDate          String?
  // Caution (guarantee deposit) — blocked, not withdrawable
  cautionBalance       Float     @default(0)
  // Caution status: none | pending | active | released
  cautionStatus        String    @default("none")
  // Personal deposit balance (distinct from mission earnings)
  personalDepositBalance Float   @default(0)
  // User level: 1=Nouveau, 2=Actif, 3=Éligible, 4=Fiable
  userLevel            Int       @default(1)
  // Reputation score (internal)
  reputationScore      Float     @default(0)
  // Date of birth
  dateOfBirth          String?
  // Country
  country              String?
  // City
  city                 String?
  // Payment method: mobile_money | bank | yas | trx
  paymentMethod        String?
  // Payment address/account number
  paymentAddress       String?
  // Account verification status: unverified | pending | verified
  accountVerified      String    @default("unverified")
  // Last activity timestamp (for inactivity detection)
  lastActivityAt       DateTime  @default(now())
  // Referral milestone: validated referrals (verified + first activity done)
  validatedReferralCount Int     @default(0)
  // Has active overdue loan (for blocking new loans)
  hasOverdueLoan       Boolean   @default(false)

  // Casino wheel game state
  gameSpinsUsed          Int       @default(0)
  gameSpinsDate          String?
  gameTotalWon           Float     @default(0)
  gameLastSpinAt         DateTime?

  transactions    Transaction[]
  investments     Investment[]
  trades          Trade[]
  enterprises     Enterprise[]
  chatMessages    ChatMessage[]
  supportTickets  SupportTicket[]
  pendingDeposits PendingDeposit[]
  passwordResetTokens PasswordResetToken[]
  withdrawals     Withdrawal[]
  yasDeposits     YasDeposit[]
  userNotifications UserNotification[]
  tradingPositions  TradingPosition[]
  missionImages   MissionImage[]
  microLoans      MicroLoan[]
  gameSpins        GameSpin[]

  // ===== Legacy: projets, gains quotidiens, plateforme vidéo =====
  // Total des gains accumulés (projets)
  earnings          Float     @default(0)
  // Plateforme vidéo — compte autonome
  videoBalance           Float     @default(0)
  videoWatchedCount      Int       @default(0)
  videoWatchedDate       String?
  videoTotalEarned       Float     @default(0)
  videoDepositRequired   Boolean   @default(false)
  videoFirstWatchAt      DateTime?
  videoLastWatchAt       DateTime?
  videoCycleNumber       Int       @default(0)
  videoCycleClearedAt    DateTime?
  projects        Project[]
  dailyGains      DailyGain[]
  videoWatches    VideoWatch[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  type      String
  amount    Float
  detail    String?
  gain      Float    @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model Investment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int
  amount      Float
  rate        Float
  totalCycles Int
  doneCycles  Int       @default(0)
  earned      Float     @default(0)
  status      String    @default("active")
  lastClaimAt DateTime?
  nextClaimAt DateTime?
  finishesAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  direction   String
  durationSec Int
  asset       String   @default("BTC")
  result      String?
  profit      Float?
  entryPrice  Float    @default(0)
  exitPrice   Float?
  endsAt      DateTime
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([resolved])
  @@index([userId, resolved])
}

model Enterprise {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  amount       Float
  durationDays Int
  daysElapsed  Int      @default(0)
  minReturn    Float
  maxReturn    Float
  finalReturn  Float?
  status       String   @default("active")
  riskEvents   String?
  finishesAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ChatMessage {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  isAdmin    Boolean   @default(false)
  isAdminMsg Boolean   @default(false)
  ticketId   String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([ticketId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PendingDeposit {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsd         Float
  amountTrx         Float
  trxPrice          Float
  userAddress       String
  txHash            String?
  destination       String    @default("balance") // balance | mission | invest_level_X | caution
  status            String    @default("pending")
  type              String    @default("deposit") // deposit | investment | caution
  investmentLevel   Int?
  investmentAmount  Float?
  paymentMethod     String?   // yas | trx
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([status, type])
}

model SiteConfig {
  id              String   @id @default("main")
  adminTrxAddress String   @default("TRMJ5R1cKbrMLy19PLu9rVtVGc5Ff2ZrHY")
  adminYasAccount String   @default("90876459")
  trxUsdPrice     Float    @default(0.12)
  cfaUsdRate      Float    @default(550)
  worldLink       String?
  // Mission system config
  missionRewardCfa    Int     @default(25)     // 25 FCFA per validated image
  missionDailyLimit   Int     @default(10)     // 10 images max per day
  missionObjectiveCfa Int     @default(2500)   // 2500 FCFA objective for loan eligibility
  cautionAmountCfa    Int     @default(5000)   // 5000 FCFA caution required
  loanSmallCfa        Int     @default(5000)   // Small loan: 5000 FCFA
  loanLargeCfa        Int     @default(10000)  // Large loan: 10000 FCFA
  loanSmallReferrals  Int     @default(5)      // 5 validated referrals for small loan
  loanLargeReferrals  Int     @default(10)     // 10 validated referrals for large loan
  loanSmallFundsCfa   Int     @default(2500)   // 2500 FCFA minimum funds for small loan
  loanLargeFundsCfa   Int     @default(5000)   // 5000 FCFA minimum funds for large loan
  loanOverdueGraceDays Int    @default(5)      // 5 days grace before referral fund deduction
  updatedAt       DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Withdrawal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  amountCfa     Float    @default(0)
  type          String   @default("trx")
  trxAddress    String?
  yasAccount    String?
  status        String   @default("pending")
  adminNote     String?
  sourceAccount String?  // jeu | investissement | projet | mission
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String   @default("email_verification")
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([used])
}

model YasDeposit {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCfa         Float     @default(0)
  amountUsd         Float
  amountTrx         Float
  trxPrice          Float
  yasAccount        String
  trxAddress        String?
  destination       String    @default("balance") // balance | caution | mission
  status            String    @default("pending")
  adminNote         String?
  type              String    @default("deposit") // deposit | investment | caution
  investmentLevel   Int?
  investmentAmount  Float?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([status, type])
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model AdminNotification {
  id           String   @id @default(cuid())
  type         String
  title        String
  message      String
  read         Boolean  @default(false)
  ticketId     String?
  userId       String?
  depositId    String?
  withdrawalId String?
  createdAt    DateTime @default(now())

  @@index([read])
  @@index([createdAt])
  @@index([type])
}

model TradingPosition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       String
  direction   String
  amount      Float
  entryPrice  Float
  currentPrice Float?
  stopLoss    Float?
  takeProfit  Float?
  profitLoss  Float?
  plPercent   Float?
  status      String   @default("open")
  closePrice  Float?
  closeReason String?
  result      String?
  openedAt    DateTime @default(now())
  closedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

// ===== Espace Jeunes: Campaigns =====
// Admin creates campaigns with brand, brief, constraints, reward
model Campaign {
  id            String   @id @default(cuid())
  name          String                    // e.g. "Campagne Mercedes - Septembre 2026"
  brand         String                    // e.g. "Mercedes"
  description   String                    // Short description
  brief         String                    // Detailed brief/instructions for image generation
  format        String   @default("16:9") // Required aspect ratio: 16:9 | 4:3 | 1:1 | 9:16
  style         String   @default("realistic") // realistic | artistic | cartoon | abstract
  constraints   String                    // Additional constraints as text
  rewardCfa     Int      @default(25)     // FCFA per validated image
  dailyLimit    Int      @default(10)     // Max images per user per day
  maxImages     Int      @default(1000)   // Max total images for campaign
  totalImages   Int      @default(0)      // Current total images submitted
  totalValidated Int     @default(0)      // Total validated images
  startDate     DateTime                  // Campaign start
  endDate       DateTime?                 // Campaign end (null = ongoing)
  status        String   @default("active") // active | paused | completed | draft
  category      String   @default("immobilier") // immobilier | automobile | mode | tech | food | travel | general
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images        MissionImage[]

  @@index([status])
  @@index([brand])
  @@index([startDate])
}

// ===== Espace Jeunes: Mission Images =====
// Images submitted by users for campaigns
model MissionImage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Image data: base64 or URL
  imageData     String                    // base64 encoded image data
  imageHash     String                    // Perceptual hash for similarity detection
  // AI Validation results
  aiScore       Float    @default(0)      // 0-100 AI validation score
  aiAnalysis    String?                    // AI analysis text (brief compliance, quality, etc.)
  similarityScore Float  @default(0)      // Max similarity to any existing image (0-1)
  similarToId   String?                    // ID of the most similar existing image
  // Status: pending | validated | refused | to_correct | duplicate | non_compliant
  status        String   @default("pending")
  // Admin review
  adminReviewed Boolean  @default(false)
  adminNote     String?
  // Reward tracking
  rewardCfa     Int      @default(0)      // Reward amount (25 FCFA if validated)
  rewardCredited Boolean @default(false)  // Whether reward was added to user balance
  // Metadata
  submittedDate String                    // YYYY-MM-DD for daily limit tracking
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([submittedDate])
  @@index([userId, submittedDate])
  @@index([imageHash])
}

// ===== Espace Jeunes: Micro Loans =====
model MicroLoan {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCfa       Int                      // 5000 or 10000
  // Status: pending | approved | active | repaying | overdue | completed | rejected
  status          String   @default("pending")
  // Dates
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  disbursedAt     DateTime?
  dueDate         DateTime?                // Repayment due date
  // Repayment tracking
  amountRepaidCfa Int      @default(0)     // Total repaid so far
  amountRemainingCfa Int                   // Remaining to repay
  // Overdue handling
  isOverdue       Boolean  @default(false)
  overdueDays     Int      @default(0)
  graceDaysRemaining Int   @default(5)     // Grace period before referral deduction
  // Admin notes
  adminNote       String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  repayments      LoanRepayment[]

  @@index([userId])
  @@index([status])
  @@index([isOverdue])
}

// ===== Espace Jeunes: Loan Repayments =====
model LoanRepayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      MicroLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amountCfa Int                       // Amount repaid in FCFA
  method    String                    // mission_earnings | personal | admin_adjustment
  status    String   @default("completed") // completed | pending | failed
  createdAt DateTime @default(now())

  @@index([loanId])
  @@index([createdAt])
}

model GameSpin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  betAmount Float
  winAmount Float    @default(0)
  result    String
  segmentIdx Int
  spinDate  String
  spunAt    DateTime @default(now())

  @@index([userId])
  @@index([spinDate])
  @@index([userId, spinDate])
}

model BroadcastMessage {
  id        String   @id @default(cuid())
  title     String
  message   String
  target    String   @default("all")
  userId    String?
  type      String   @default("info")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target])
}

// ===== Legacy: projets utilisateur + gains quotidiens =====
model Project {
  id             String        @id @default(cuid())
  name           String
  amount         Float
  receivedAmount Float         @default(0)
  description    String
  status         String        @default("active")
  dailyRate      Float         @default(10)
  category       String        @default("general")
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  dailyGains     DailyGain[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model DailyGain {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rate      Float
  amount    Float
  date      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([date])
}

// ===== Plateforme vidéo =====
model VideoWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  title     String
  reward    Float
  watchedAt DateTime @default(now())
  watchDate String

  @@index([userId])
  @@index([watchDate])
  @@index([userId, watchDate])
}

// Liens vidéo gérés par l'admin. Priorité sur le catalogue par défaut.
model AdminVideoLink {
  id          String   @id @default(cuid())
  youtubeId   String
  title       String
  sponsor     String
  category    String   @default("entreprise")
  durationMin Int      @default(5)
  reward      Float    @default(0.20)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}
