generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  password        String
  balance         Float         @default(0)
  investBalance   Float         @default(0)
  tradeBalance    Float         @default(0)
  projectBalance  Float         @default(0)
  hasInvested     Boolean       @default(false)
  role            String        @default("user")
  emailVerified   Boolean       @default(false)
  depositCount    Int           @default(0)
  firstDepositAt  DateTime?
  lastClaimAt     DateTime?
  referralCode    String        @unique
  referredByCode  String?
  referralCount   Int           @default(0)
  totalProfit     Float         @default(0)
  totalLoss       Float         @default(0)
  unlockedLevel   Int           @default(1)
  requiredReferrals Int         @default(0)
  totalInvestClaims Int         @default(0)
  investClaimBlocked Boolean     @default(false)
  worldLinkSeen   Boolean       @default(false)
  // Anti-fraud: unique phone number per account + session token to prevent
  // concurrent logins with the same account on multiple devices.
  phone           String?       @unique
  sessionToken    String?
  // Referral milestone reward: $5 credited to principal when user reaches 12
  // active referrals. Tracked to avoid crediting twice.
  referralRewardClaimed Boolean @default(false)
  // Level-2 investment withdrawal hold (escrow). When a user transfers funds
  // OUT of the investment account before unlocking level 2 (12 referrals) the
  // amount is held here and released to the principal balance only after
  // 10 days AND level-2 unlock. Hidden from the UI.
  heldInvestBalance Float      @default(0)
  heldReleaseAt     DateTime?
  // Video platform autonomous account
  videoBalance           Float     @default(0)
  videoWatchedCount      Int       @default(0)
  videoWatchedDate       String?
  videoTotalEarned       Float     @default(0)
  videoDepositRequired   Boolean   @default(false)
  videoFirstWatchAt      DateTime?
  videoLastWatchAt       DateTime?
  videoWatchedVideoIds   String    @default("[]")
  // 3-day cycle tracking: every 3 days of watching, user must deposit at
  // investment Level 1 AND invite (cycleNumber) referrals to continue withdrawing.
  videoCycleNumber       Int       @default(0)   // last cycle the user cleared
  videoCycleClearedAt    DateTime?               // when the current cycle was cleared
  // Casino wheel game state
  gameSpinsUsed          Int       @default(0)
  gameSpinsDate          String?
  gameTotalWon           Float     @default(0)
  gameLastSpinAt         DateTime?
  transactions    Transaction[]
  investments     Investment[]
  trades          Trade[]
  enterprises     Enterprise[]
  chatMessages    ChatMessage[]
  supportTickets  SupportTicket[]
  pendingDeposits PendingDeposit[]
  passwordResetTokens PasswordResetToken[]
  withdrawals     Withdrawal[]
  yasDeposits     YasDeposit[]
  userNotifications UserNotification[]
  tradingPositions  TradingPosition[]
  videoWatches     VideoWatch[]
  gameSpins        GameSpin[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  type      String
  amount    Float
  detail    String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

model Investment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int
  amount      Float
  rate        Float
  totalCycles Int
  doneCycles  Int       @default(0)
  earned      Float     @default(0)
  status      String    @default("active")
  lastClaimAt DateTime?
  nextClaimAt DateTime?
  finishesAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  direction   String
  durationSec Int
  asset       String   @default("BTC")
  result      String?
  profit      Float?
  entryPrice  Float    @default(0)
  exitPrice   Float?
  endsAt      DateTime
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([resolved])
  @@index([userId, resolved])
}

model Enterprise {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  amount       Float
  durationDays Int
  daysElapsed  Int      @default(0)
  minReturn    Float
  maxReturn    Float
  finalReturn  Float?
  status       String   @default("active")
  riskEvents   String?
  finishesAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ChatMessage {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  isAdmin    Boolean   @default(false)
  isAdminMsg Boolean   @default(false)
  ticketId   String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([ticketId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PendingDeposit {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsd         Float
  amountTrx         Float
  trxPrice          Float
  userAddress       String
  txHash            String?
  destination       String    @default("balance") // balance | video | invest_level_X
  status            String    @default("pending")
  // Investment approval flow: type distinguishes principal-wallet deposits
  // from investment deposits. When type='investment', admin approval
  // creates the Investment record (countdown starts at approval time).
  type              String    @default("deposit") // deposit | investment
  investmentLevel   Int?
  investmentAmount  Float?
  paymentMethod     String?   // yas | trx
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([status, type])
}

model SiteConfig {
  id              String   @id @default("main")
  adminTrxAddress String   @default("TRMJ5R1cKbrMLy19PLu9rVtVGc5Ff2ZrHY")
  adminYasAccount String   @default("90876459")
  trxUsdPrice     Float    @default(0.12)
  cfaUsdRate      Float    @default(600)
  worldLink       String?
  updatedAt       DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  amountCfa   Float    @default(0)
  type        String   @default("trx")
  trxAddress  String?
  yasAccount  String?
  status      String   @default("pending")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String   @default("email_verification")
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([used])
}

model YasDeposit {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCfa         Float     @default(0)
  amountUsd         Float
  amountTrx         Float
  trxPrice          Float
  yasAccount        String
  trxAddress        String?
  destination       String    @default("balance")
  status            String    @default("pending")
  adminNote         String?
  // Investment approval flow: type distinguishes principal-wallet deposits
  // from investment deposits. When type='investment', admin approval
  // creates the Investment record (countdown starts at approval time).
  type              String    @default("deposit") // deposit | investment
  investmentLevel   Int?
  investmentAmount  Float?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([status, type])
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // deposit_approved, deposit_rejected, withdrawal_approved, withdrawal_rejected, new_message, referral_new, investment_claim, trade_result
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?  // optional navigation link (e.g. 'wallet', 'chat')
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model AdminNotification {
  id           String   @id @default(cuid())
  type         String
  title        String
  message      String
  read         Boolean  @default(false)
  ticketId     String?
  userId       String?
  // Investment approval flow: link back to the pending deposit or
  // withdrawal that triggered this admin notification.
  depositId    String?  // PendingDeposit.id or YasDeposit.id
  withdrawalId String?  // Withdrawal.id
  createdAt    DateTime @default(now())

  @@index([read])
  @@index([createdAt])
  @@index([type])
}

model TradingPosition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset       String   // EUR/USD, GBP/USD, BTC/USD, ETH/USD, GOLD/USD, SILVER/USD
  direction   String   // BUY or SELL
  amount      Float    // Amount in USD
  entryPrice  Float    // Price when position was opened
  currentPrice Float?  // Latest price (updated by system)
  stopLoss    Float?   // Stop loss percentage (e.g. 5 means 5%)
  takeProfit  Float?   // Take profit percentage (e.g. 15 means 15%)
  profitLoss  Float?   // Current P/L in USD
  plPercent   Float?   // Current P/L percentage
  status      String   @default("open") // open, closed, liquidated
  closePrice  Float?   // Price when position was closed
  closeReason String?  // manual, stop_loss, take_profit, liquidated
  result      String?  // win, loss
  openedAt    DateTime @default(now())
  closedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model VideoWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String   // YouTube video ID
  title     String
  reward    Float    // Reward amount in USD
  watchedAt DateTime @default(now())
  watchDate String   // Date string YYYY-MM-DD for daily limit tracking

  @@index([userId])
  @@index([watchDate])
  @@index([userId, watchDate])
}

model GameSpin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  betAmount Float    // Amount bet in USD
  winAmount Float    @default(0) // Amount won (0 if lost)
  result    String   // win, loss
  segmentIdx Int     // Which segment the wheel landed on
  spinDate  String   // Date string YYYY-MM-DD for daily limit tracking
  spunAt    DateTime @default(now())

  @@index([userId])
  @@index([spinDate])
  @@index([userId, spinDate])
}

// Admin-managed video links.
// The administrator can add any YouTube video link they want users to watch.
// Admin links take priority over the default daily catalog when active.
// totalCycles = 0 means unlimited collection days (no finite cycle cap).
model AdminVideoLink {
  id          String   @id @default(cuid())
  youtubeId   String   // YouTube video ID (real, embeddable)
  title       String   // Title that conforms to the video content
  sponsor     String   // Company / sponsor name
  category    String   @default("entreprise") // chinois | japonais | indien | entreprise
  durationMin Int      @default(5)
  reward      Float    @default(0.20) // 0.15 - 0.30 USD
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// Admin broadcast messages sent to all users (or a specific user).
// Persisted so the admin can review past broadcasts.
model BroadcastMessage {
  id        String   @id @default(cuid())
  title     String
  message   String
  target    String   @default("all") // all | individual
  userId    String?  // only set when target = individual
  type      String   @default("info") // info | promo | alert | maintenance
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([target])
}
